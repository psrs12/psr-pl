FROM node:20-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

ARG VITE_APP_MANAGEMENT_API_URL
ARG VITE_PRICING_API_URL
ARG VITE_OFFER_ACCEPTANCE_API_URL
ARG VITE_DOCUMENT_API_URL
ARG VITE_PRICING_OFFERS_UI_JS_URL
ARG VITE_DOCUMENT_MANAGEMENT_UI_JS_URL
ARG VITE_OFFER_ACCEPTANCE_UI_JS_URL

ENV VITE_APP_MANAGEMENT_API_URL=$VITE_APP_MANAGEMENT_API_URL
ENV VITE_PRICING_API_URL=$VITE_PRICING_API_URL
ENV VITE_OFFER_ACCEPTANCE_API_URL=$VITE_OFFER_ACCEPTANCE_API_URL
ENV VITE_DOCUMENT_API_URL=$VITE_DOCUMENT_API_URL
ENV VITE_PRICING_OFFERS_UI_JS_URL=$VITE_PRICING_OFFERS_UI_JS_URL
ENV VITE_DOCUMENT_MANAGEMENT_UI_JS_URL=$VITE_DOCUMENT_MANAGEMENT_UI_JS_URL
ENV VITE_OFFER_ACCEPTANCE_UI_JS_URL=$VITE_OFFER_ACCEPTANCE_UI_JS_URL

RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
