{
  "Comment": "pricing-orchestration workflow: soft pull -> price -> hard pull -> decide -> update application status. Started by application-management-service on submission (see CLAUDE.md's Workflow Architecture: Persist Application -> Start Step Function).",
  "StartAt": "SoftPullRequest",
  "States": {
    "SoftPullRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SoftPullLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "score.$": "$.Payload.score",
        "source.$": "$.Payload.source"
      },
      "ResultPath": "$.softPull",
      "Next": "PricingCalculation"
    },
    "PricingCalculation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${EcsClusterArn}",
        "TaskDefinition": "${PricingFargateTaskDefinitionArn}",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "pricing-fargate",
              "Environment": [
                { "Name": "TASK_INPUT", "Value.$": "States.JsonToString($)" },
                { "Name": "TASK_TOKEN", "Value.$": "$$.Task.Token" }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.pricedOffer",
      "Next": "HardPullRequest"
    },
    "HardPullRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${HardPullLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "score.$": "$.Payload.score",
        "source.$": "$.Payload.source"
      },
      "ResultPath": "$.hardPull",
      "Next": "DecisionRouting"
    },
    "DecisionRouting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DecisionLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "outcome.$": "$.Payload.outcome",
        "reason.$": "$.Payload.reason"
      },
      "ResultPath": "$.decision",
      "Next": "UpdateApplicationStatus"
    },
    "UpdateApplicationStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${UpdateStatusLambdaArn}",
        "Payload.$": "$"
      },
      "ResultPath": null,
      "End": true
    }
  }
}
