{
  "Comment": "pricing-orchestration workflow: soft pull -> price -> await applicant offer selection + hard-pull consent -> hard pull -> decide -> update application status. Started by application-management-service on submission (see CLAUDE.md's Workflow Architecture: Persist Application -> Start Step Function).",
  "StartAt": "SoftPullRequest",
  "States": {
    "SoftPullRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SoftPullLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "score.$": "$.Payload.score",
        "source.$": "$.Payload.source"
      },
      "ResultPath": "$.softPull",
      "Next": "PricingCalculation"
    },
    "PricingCalculation": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.waitForTaskToken",
      "Parameters": {
        "LaunchType": "FARGATE",
        "Cluster": "${EcsClusterArn}",
        "TaskDefinition": "${PricingFargateTaskDefinitionArn}",
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "pricing-fargate",
              "Environment": [
                { "Name": "TASK_INPUT", "Value.$": "States.JsonToString($)" },
                { "Name": "TASK_TOKEN", "Value.$": "$$.Task.Token" }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.pricedOffers",
      "Next": "AwaitOfferSelection"
    },
    "AwaitOfferSelection": {
      "Comment": "Pauses until the applicant selects one of the offers and gives hard-pull consent, via pricing-orchestration-service's selected-offer API (POST .../confirm calls SendTaskSuccess with this task's token) -- not resumed by this Lambda itself.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${PresentOfferLambdaArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "applicationId.$": "$.applicationId",
          "pricedOffers.$": "$.pricedOffers",
          "requestId.$": "$.requestId"
        }
      },
      "ResultPath": "$.offerSelection",
      "Next": "ConsentGivenCheck"
    },
    "ConsentGivenCheck": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.offerSelection.consentGiven", "BooleanEquals": true, "Next": "HardPullRequest" }
      ],
      "Default": "ConsentDeclined"
    },
    "ConsentDeclined": {
      "Comment": "No hard pull without explicit consent -- this is the FCRA gate, not an optional branch.",
      "Type": "Pass",
      "Parameters": {
        "outcome": "DECLINED",
        "reason": "applicant did not give hard-pull consent"
      },
      "ResultPath": "$.decision",
      "Next": "UpdateApplicationStatus"
    },
    "HardPullRequest": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${HardPullLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "score.$": "$.Payload.score",
        "source.$": "$.Payload.source"
      },
      "ResultPath": "$.hardPull",
      "Next": "DecisionRouting"
    },
    "DecisionRouting": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${DecisionLambdaArn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "outcome.$": "$.Payload.outcome",
        "reason.$": "$.Payload.reason"
      },
      "ResultPath": "$.decision",
      "Next": "UpdateApplicationStatus"
    },
    "UpdateApplicationStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${UpdateStatusLambdaArn}",
        "Payload.$": "$"
      },
      "ResultPath": null,
      "End": true
    }
  }
}
